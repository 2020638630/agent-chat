# 服务端口
PORT=8787
# HOST=127.0.0.1
# PROACTIVE_INTERVAL_MS=60000

# === ARCH-2 Provider 配置（统一入口：apps/server/src/config/providers.ts）===
# 业务侧经 providers 取 baseUrl/apiKey/model，再调 OpenAI 兼容请求。
# 本刀不做运行时动态路由（N-02）；换供应商只改本文件对应键。

# LLM：默认 Ollama（OpenAI 兼容）
# LLM_PROVIDER=ollama 时（或 baseURL 含 11434）会附加 reasoning_effort: "none"
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b-nothink

# 私聊读图视觉模型（可空；空则回退 LLM_MODEL）。与 LLM 共用 baseUrl/apiKey。
# DeepSeek 纯文本勿填。例：qwen2.5vl:7b / llava
LLM_VISION_MODEL=

# 备用 DeepSeek（密钥只写本机 .env，勿提交；不要带 reasoning_effort）
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat

# STT（语音识别）
STT_BASE_URL=https://api.siliconflow.cn/v1
STT_API_KEY=
STT_MODEL=FunAudioLLM/SenseVoiceSmall

# TTS（语音合成）
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_API_KEY=
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
TTS_VOICE_MALE=FunAudioLLM/CosyVoice2-0.5B:alex
TTS_VOICE_FEMALE=FunAudioLLM/CosyVoice2-0.5B:anna
TTS_VOICE_USER=FunAudioLLM/CosyVoice2-0.5B:david

# 私聊生图（OpenAI 兼容；默认硅基流动）
IMAGE_GEN_BASE_URL=https://api.siliconflow.cn/v1
# D-09：请显式填写 IMAGE_GEN_API_KEY。空时仍可短暂回落 STT_API_KEY（兼容期，会打 warn；后续可能移除）。
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=Kwai-Kolors/Kolors

# R-04x memory write-gate spike（默认 off）。off|laya|heuristic
MEMORY_GATE_BACKEND=off
# Optional: LAYA_PYTHON=python  LAYA_MODEL=convaiinnovations/laya-multilingual
# LAYA_GATE_SCRIPT=


# === ARCH-2 try-run optional keys（只写键名；值只放本机 .env，永不入库）===
# DeepSeek 官方文本试跑：也可不设下面两项，改用上方 LLM_* 指向 https://api.deepseek.com
# DEEPSEEK_API_KEY=
# 云读图（硅基 Qwen3-VL 等）：把 LLM_BASE_URL/LLM_API_KEY/LLM_VISION_MODEL 临时指到硅基即可
# LLM_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Gemini TTS 试跑（非 OpenAI 兼容；scripts/arch2-tryrun.py 直打）：
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional try-run keys (empty OK; values only in local .env, never commit)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
