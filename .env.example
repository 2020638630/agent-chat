# 服务端口
PORT=8787

# LLM：默认 Ollama（OpenAI 兼容）
# LLM_PROVIDER=ollama 时（或 baseURL 含 11434）会附加 reasoning_effort: "none"
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:9b-nothink

# 备用 DeepSeek（密钥只写本机 .env，勿提交；不要带 reasoning_effort）
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat